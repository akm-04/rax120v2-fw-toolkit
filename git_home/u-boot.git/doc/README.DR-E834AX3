How to build:
Developed based on QCA "qsdk-ipq807x.ilq.10.0-spf.10.0.fc".
=============

export PATH="/PATH/TO/toolchain-arm_cortex-a7_gcc-5.2.0_musl-1.1.16_eabi/bin:$PATH"
export STAGING_DIR="/PATH/TO/toolchain-arm_cortex-a7_gcc-5.2.0_musl-1.1.16_eabi/.."
make hw29766097p0p512p1024p2x2p2x2p2x2_defconfig

VERSION_CODE='Chaos Calmer 15.05.1' REVISION='95bec74+r49254' make HOSTSTRIP=true CROSS_COMPILE=arm-openwrt-linux-muslgnueabi- TARGETCC=arm-openwrt-linux-muslgnueabi-gcc KCPPFLAGS="" CONFIG_QCA_SINGLE_IMG_GIT="/PATH/TO/git-home/qsdk-chipcode.git" all

Steps to upgrade uboot "uboot-xxx.img" :
=============================================
IPQ807x# setenv machid 801000c
IPQ807x# setenv ipaddr 192.168.1.1 && setenv serverip 192.168.1.10
IPQ807x# tftpboot 0x42000000 uboot-hw29766097p0p512p1024p2x2p2x2p2x2.img 
IPQ807x# crc32 0x42000000 ${filesize}
IPQ807x# imgaddr=0x42000000 && source $imgaddr:script
IPQ807x# reset
IPQ807x# delenv
IPQ807x# reset
