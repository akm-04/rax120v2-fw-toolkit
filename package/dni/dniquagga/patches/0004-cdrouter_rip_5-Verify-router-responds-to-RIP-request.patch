diff --git a/ripd/ripd.c b/ripd/ripd.c
index 092170b..fc76b86 100644
--- a/ripd/ripd.c
+++ b/ripd/ripd.c
@@ -1662,6 +1662,11 @@ rip_request_process (struct rip_packet *packet, int size,
   if (lim == (caddr_t) rte)
     return;
 
+  /*For RIP request packet that include authentication options, Set RTE point  er*/
+  if(ntohs(rte->tag) == RIP_AUTH_SIMPLE_PASSWORD || ntohs(rte->tag) == RIP_AUTH_MD5){
+	      rte++;
+   }
