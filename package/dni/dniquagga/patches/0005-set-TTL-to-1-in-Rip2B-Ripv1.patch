From 46965138c6cb9db9bf54e435914f38103bbe19ea Mon Sep 17 00:00:00 2001
From: "boxiang.chen" <boxiang.chen@dniserver.dnish.net>
Date: Thu, 15 Oct 2020 11:46:22 +0800
Subject: [PATCH] set TTL to 1 in Rip2B && Ripv1

---
 ripd/ripd.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/ripd/ripd.c b/ripd/ripd.c
index fc76b86..5b84e23 100644
--- a/ripd/ripd.c
+++ b/ripd/ripd.c
@@ -93,6 +93,7 @@ sockopt_broadcast (int sock)
 {
   int ret;
   int on = 1;
+  int ttl = 1;
 
   ret = setsockopt (sock, SOL_SOCKET, SO_BROADCAST, (char *) &on, sizeof on);
   if (ret < 0)
@@ -100,6 +101,14 @@ sockopt_broadcast (int sock)
       zlog_warn ("can't set sockopt SO_BROADCAST to socket %d", sock);
       return -1;
     }
+
+  ret = setsockopt (sock, IPPROTO_IP, IP_TTL, (void *) &ttl, sizeof (ttl));
+  if (ret < 0)
+    {
+      zlog_warn ("can't set sockopt IP_TTL  %d to socket %d", ttl, sock);
+      return -1;
+    }
+ 
   return 0;
 }
 
