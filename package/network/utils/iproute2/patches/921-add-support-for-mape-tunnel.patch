+static int do_addmape(int argc, char **argv)
+{
+	struct iptun_req req; 
+	inet_prefix prefix;
+	uint32_t label = 0xffffffffUL;
+	//char *p = NULL;
+	//char *l = NULL;        
+
+	struct ip6_tnl_parm2 p;
+
+	memset(&req, 0, sizeof(req));
+	memset(&prefix, 0, sizeof(prefix));
+	req.n.nlmsg_type = RTM_NEWLINK;
+	req.n.nlmsg_len = NLMSG_LENGTH(sizeof(struct ifinfomsg));
+	req.n.nlmsg_flags = NLM_F_REQUEST | NLM_F_CREATE | NLM_F_REPLACE;
+	req.i.ifi_family = preferred_family;
+
+	ip6_tnl_parm_init(&p, 1);
+
+	if (parse_args(argc, argv, SIOCADDTUNNEL, &p) < 0)
+		return -1;
+
+
+	addattrstrz(&req.n, 1024, IFLA_IFNAME, p.name);
+	if (p.link)
+		addattr32(&req.n, 1024, IFLA_LINK, p.link);
+
+	struct rtattr *linkinfo = addattr_nest(&req.n, sizeof(req), IFLA_LINKINFO);
+	addattrstrz(&req.n, 1024, IFLA_INFO_KIND, "ip6tnl");
+	
+	struct rtattr *infodata = addattr_nest(&req.n, sizeof(req), IFLA_INFO_DATA);
+	if (p.link)
+		addattr32(&req.n, 1024, IFLA_IPTUN_LINK, p.link);
+	
+	addattr8(&req.n, sizeof(req), IFLA_IPTUN_PROTO, IPPROTO_IPIP);
+	addattr8(&req.n, sizeof(req), IFLA_IPTUN_TTL, (p.hop_limit) ? p.hop_limit : 64);
+	addattr8(&req.n, sizeof(req), IFLA_IPTUN_ENCAP_LIMIT, 4);
+	addattr8(&req.n, sizeof(req), IFLA_IPTUN_DRAFT03, p.draft03);
+
+	addattr_l(&req.n, sizeof(req), IFLA_IPTUN_LOCAL, &p.laddr, sizeof(p.laddr));
+	addattr_l(&req.n, sizeof(req), IFLA_IPTUN_REMOTE, &p.raddr, sizeof(p.raddr));
+
+	do_add_map_fmrs(&req, &p);
+
+	addattr_nest_end(&req.n, infodata);
+	addattr_nest_end(&req.n, linkinfo);
+	
+	ll_init_map(&rth);
+
+	if (rtnl_talk(&rth, &req.n, 0, 0, NULL) < 0)
+		exit(2);
+
+	free_fmrs_list(&p.fmrs);	
+	return 0;
+}
+
+static void do_add_map_fmrs(struct iptun_req *req, struct ip6_tnl_parm *p)
+{
+	struct rtattr *fmrs = addattr_nest(&req->n, sizeof(*req), IFLA_IPTUN_FMRS);
+	struct __ip6_tnl_fmr *c;
+	int fmrcnt = 0;
+	for (c = p->fmrs; c; c = c->next) {
+		struct rtattr *rule = addattr_nest(&req->n, sizeof(*req), ++fmrcnt);
+		addattr_l(&req->n, sizeof(*req), IFLA_IPTUN_FMR_IP6_PREFIX, &c->ip6_prefix, sizeof(struct in6_addr));
+		addattr_l(&req->n, sizeof(*req), IFLA_IPTUN_FMR_IP4_PREFIX, &c->ip4_prefix, sizeof(struct in_addr));
+		addattr8(&req->n, sizeof(*req), IFLA_IPTUN_FMR_IP6_PREFIX_LEN, c->ip6_prefix_len);
+		addattr8(&req->n, sizeof(*req), IFLA_IPTUN_FMR_IP4_PREFIX_LEN, c->ip4_prefix_len);
+		addattr8(&req->n, sizeof(*req), IFLA_IPTUN_FMR_EA_LEN, c->ea_len);
+		addattr8(&req->n, sizeof(*req), IFLA_IPTUN_FMR_OFFSET, c->offset);
+		addattr_nest_end(&req->n, rule);
+	}
+	addattr_nest_end(&req->n, fmrs);
+}
