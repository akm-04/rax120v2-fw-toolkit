+static void free_fmrs_list(struct __ip6_tnl_fmr **fmrs)
+{
+	struct __ip6_tnl_fmr *c, *cur_p = *fmrs;
+
+	for (c = *fmrs; cur_p;) {
+		cur_p = c->next;
+		free(c);
+		c = cur_p;
+	}
+	*fmrs = NULL;
+}
+
+/* rule_list = 2001:1::/32,10.10.0.0/16,26,4|2001:2::/32,10.20.0.0/16,26,4.....
+ * v6prefix/v6prefixlen,v4prefix/v4prefixlen,ealen,offset */
+void parse_fmrs_rules(struct __ip6_tnl_fmr **fmrs, char *rule_list_p)
+{
+	struct __ip6_tnl_fmr *fmrs_each_p = *fmrs, *rule_p = NULL;
+	char *rule_each_p = NULL, *list_p = rule_list_p;
+	char v6pre[64] = {0}, v4pre[32] = {0};
+	int v6plen = 0, v4plen = 0, ealen = 0, offset = 0, num = 0;
+	inet_prefix faddr;
+
+	while ((rule_each_p = strsep(&list_p, "|")) != NULL)
+	{
+		num = sscanf(rule_each_p, "%[^/]/%d,%[^/]/%d,%d,%d", v6pre, &v6plen, v4pre, &v4plen, &ealen, &offset);
+		if (num != 6)
+		{
+			fprintf(stderr, "get value failed, num=%d\n", num);
+			return;
+		}
+		fprintf(stderr, "get one rule: %s/%d,%s/%d, %d,%d\n", v6pre, v6plen, v4pre, v4plen, ealen, offset);
+		rule_p = (struct __ip6_tnl_fmr *)calloc(1, sizeof(struct __ip6_tnl_fmr));
+		get_prefix(&faddr, v6pre, preferred_family);
+		if (faddr.family == AF_UNSPEC)
+			invarg("\"remote\" address family is AF_UNSPEC", v6pre);
+		memcpy(&rule_p->ip6_prefix, &faddr.data, sizeof(struct in6_addr));
+		get_prefix(&faddr, v4pre, AF_INET);
+		if (faddr.family == AF_UNSPEC)
+			invarg("\"remote\" address family is AF_UNSPEC", v4pre);
+		memcpy(&rule_p->ip4_prefix, &faddr.data, sizeof(struct in_addr));
+
+		rule_p->ip6_prefix_len = v6plen;
+		rule_p->ip4_prefix_len = v4plen;
+		rule_p->ea_len = ealen;
+		rule_p->offset = offset;
+		if (*fmrs == NULL)
+		{
+			*fmrs = rule_p;
+			fmrs_each_p = *fmrs;
+		}
+		else
+		{
+			fmrs_each_p->next = rule_p;
+			fmrs_each_p = rule_p;
+		}
+	}
+
+	return;
+}
