#!/bin/sh
# ovpn_client_custom.env — sourced by ovpn_update_config.sh, ovpn_ctrl.sh.
#
# Deliberately separate from the OEM's own /etc/openvpn/openvpn_client.env
# and its tun80/purevpn.sh flow, even though the custom frontend has
# already replaced the GUI's access to that flow -- the underlying OEM
# scripts and NVRAM keys still physically exist on the device, so this
# uses its own tunnel device name and its own NVRAM key namespace
# (vpn_client_custom_ovpn_*) to guarantee no collision if anything ever
# still touches tun80 or the vpn_client_ovpn_cfg_* keys.

. /etc/vpn_client/vpn_common.env

ovpn_iface="tun90"
ovpn_client_data_dir="/tmp/openvpn_custom"
ovpn_client_conf_file="${ovpn_client_data_dir}/custom.ovpn"   # regenerated every connect, never read back
ovpn_client_log_file="${ovpn_client_data_dir}/openvpn.log"
ovpn_client_stat_file="${ovpn_client_data_dir}/ovpn_status.json"
ovpn_client_pid_file="${ovpn_client_data_dir}/openvpn.pid"

# nvram keys
NVK_OVPN_BLOB="vpn_client_custom_ovpn_blob"      # base64 of the full validated .ovpn file
NVK_OVPN_CONFIGURED="vpn_client_custom_ovpn_configured"  # "1" once a valid config has been saved
NVK_OVPN_SCOPE_IFACES="vpn_client_custom_ovpn_scope_ifaces"  # space-separated VAPs, empty = whole router
NVK_OVPN_USER="vpn_client_custom_user"           # written by vpn_auth.mod
NVK_OVPN_PASS="vpn_client_custom_pass"           # written by vpn_auth.mod
