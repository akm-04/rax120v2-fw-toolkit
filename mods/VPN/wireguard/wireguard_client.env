#!/bin/sh
# wireguard_client.env — sourced by wg_update_config.sh, wg_ctrl.sh,
# wg_watchdog.sh. Flat layout: this file and every backend script (both
# protocols, plus the shared dispatcher) live together in /etc/vpn_client/.

. /etc/vpn_client/vpn_common.env

wg_iface="wg0"
wg_client_data_dir="/tmp/wireguard"
wg_client_conf_file="${wg_client_data_dir}/wg0.conf"          # regenerated every connect, never read back
wg_client_log_file="${wg_client_data_dir}/wireguard.log"
wg_client_stat_file="${wg_client_data_dir}/wg_status.json"
wg_watchdog_pid_file="${wg_client_data_dir}/watchdog.pid"

# watchdog timing (seconds)
wg_watchdog_interval=5
wg_stale_threshold=180        # no handshake within this window -> considered dead
wg_hard_reconnect_after=300   # still dead after this long -> full teardown + re-init

# nvram keys (all read/written via /bin/config)
NVK_PRIVATEKEY="vpn_client_wg_privatekey"
NVK_ADDRESS="vpn_client_wg_address"
NVK_DNS="vpn_client_wg_dns"
NVK_PEER_PUBKEY="vpn_client_wg_peer_pubkey"
NVK_ENDPOINT="vpn_client_wg_endpoint"
NVK_ALLOWEDIPS="vpn_client_wg_allowedips"
NVK_KEEPALIVE="vpn_client_wg_keepalive"
NVK_SCOPE_IFACES="vpn_client_wg_scope_ifaces"  # space-separated VAPs, empty = whole router
NVK_CONFIGURED="vpn_client_wg_configured"      # "1" once a valid config has been parsed+saved
