#!/bin/sh
# vpn_common.env — sourced by vpn_ctrl.sh (the dispatcher) and by both
# protocols' backends. Holds only what genuinely needs to be shared:
# the active-protocol selector, and the fwmark/table both protocols'
# "global" mode use. Since only one VPN is ever active (single-VPN
# design, no dual-protocol concurrency), wg_ctrl.sh and ovpn_ctrl.sh
# safely share the same mark/table rather than needing separate ones.

NVK_ACTIVE_PROTOCOL="vpn_client_active_protocol"   # "wireguard" | "openvpn" -- unset/unrecognized defaults to wireguard
NVK_AUTO_ENABLE="vpn_client_auto_enable"           # "1"/"0" -- auto-connect on boot, shared across protocols
NVK_BOOT_DELAY="vpn_client_boot_delay_sec"         # seconds to wait after boot before the first connect
                                                    # attempt (and starting the watchdog) -- see
                                                    # custom_vpn.init's boot() for why, and for the
                                                    # self-healing default when this is empty/invalid
NVK_SCOPE_DNS="vpn_client_scope_dns"               # Frontend-settable DNS override, used by BOTH global
                                                    # and selective-scope modes (see resolve_scope_dns()
                                                    # below) -- "not set" is represented as either a truly
                                                    # empty value OR the literal string "0" (the frontend
                                                    # writes "0" rather than leaving the key absent).
                                                    # Neither protocol ever touches /tmp/resolv.conf or
                                                    # restarts dnsmasq for this -- both apply DNS purely via
                                                    # iptables DNAT (+ ip6tables DROP for IPv6, since neither
                                                    # tunnel carries IPv6 and 6to4/happy-eyeballs can
                                                    # otherwise route real payload traffic around a
                                                    # v4-only tunnel entirely, not just DNS -- confirmed via
                                                    # live leak testing on RAX120v2). This replaced an
                                                    # earlier resolv.conf-swap design (ported from OEM's own
                                                    # ovpn_update_conn_status.sh) that looked correct in
                                                    # isolation but caused two separate live failures: an
                                                    # IPv6-only DNS leak in WireGuard whole-router mode, and
                                                    # a total DNS outage in OpenVPN whole-router mode when
                                                    # the provider didn't push any DNS option at all. OEM's
                                                    # scripts were written for one known, predictable
                                                    # provider's config shape; this toolkit has to handle
                                                    # arbitrary uploaded configs from any provider, which
                                                    # doesn't hold to the same assumptions.

# resolve_scope_dns <provider_dns>
#
# Shared DNS priority resolver for both protocols' whole-router AND
# selective-scope modes: frontend NVRAM override > provider/config-supplied
# DNS > 1.1.1.1 hard default. <provider_dns> may be empty, or a comma-
# separated list (WireGuard's DNS field can carry more than one server) --
# only the first is used, keeping exactly one value to apply/track/tear
# down rather than juggling a set.
#
# Where <provider_dns> comes from differs by protocol and is the caller's
# job to supply, NOT this function's:
#   - WireGuard: known statically at connect-time, from the uploaded peer
#     config's own DNS field (already parsed into $DNS by wg_update_config.sh
#     at upload time) -- pass it straight in.
#   - OpenVPN: NOT knowable until the tunnel is already up. Providers like
#     NordVPN/ProtonVPN push DNS dynamically over the control channel
#     during the handshake -- it exists ONLY in the foreign_option_* env
#     vars OpenVPN's own --up hook receives, never in the static .ovpn
#     file. ovpn_ctrl.sh's dns_up (its --up hook) parses those and passes
#     the result in here; there is no way to learn this before the tunnel
#     comes up, and no way to learn it at all without the hook.
resolve_scope_dns()
{
	PROVIDER_DNS="$1"
	NVRAM_DNS=$($CONFIG get ${NVK_SCOPE_DNS})
	case "$NVRAM_DNS" in
		""|"0") NVRAM_DNS="" ;;
	esac

	if [ -n "$NVRAM_DNS" ]; then
		echo "$NVRAM_DNS"
	elif [ -n "$PROVIDER_DNS" ]; then
		echo "$PROVIDER_DNS" | cut -d',' -f1
	else
		echo "1.1.1.1"
	fi
}

vpn_fwmark="0x10"
vpn_rt_table="100"

# The full set of interfaces that can ever be scoped to -- used by
# do_disconnect in both wg_ctrl.sh and ovpn_ctrl.sh to unconditionally
# flush every possible physdev mark rule on every disconnect, rather than
# only the ones a (possibly stale/garbage) tracked scope says were
# applied. Since this mark/table is fully owned by this toolkit, a full
# wipe-and-rebuild on every connect/disconnect cycle is cheap and removes
# an entire class of "orphaned rule from an earlier, different scope"
# bugs.
#
# ath0/ath1 = main 5GHz/2.4GHz radios, ath01/ath11 = guest 5GHz/2.4GHz
# VAPs, eth0-eth5 = the router's physical switch ports -- all are br0
# bridge members (see custom_vpn.init or `brctl show` for the live
# membership list), so physdev-in matching applies identically to wired
# and wireless ports. Whichever port is currently doing WAN duty is NOT
# a br0 member (it's in brwan instead, see get_wan_ifaces() below) --
# scoping it would just silently match nothing rather than doing
# anything harmful, but the frontend excludes it anyway to avoid the
# confusion of a checkbox that visibly does nothing.
VPN_KNOWN_SCOPE_IFACES="ath0 ath01 ath1 ath11 eth0 eth1 eth2 eth3 eth4 eth5"

# get_wan_ifaces -- lists whichever physical interface(s) are currently
# bridged into brwan (the WAN-side bridge), i.e. currently doing WAN duty.
# Read straight from sysfs bridge membership (one directory entry per
# port) rather than parsing `brctl show`'s multi-line table -- sysfs is
# what brctl itself ultimately reads, just far simpler to consume
# reliably from a shell script. Which port this is can change (WAN can be
# reassigned to a different physical port), so this is checked live
# rather than assumed static.
get_wan_ifaces()
{
	ls /sys/class/net/brwan/brif/ 2>/dev/null
}

# --- upload size guards -----------------------------------------------
# Two limits, checked at two different points:
#
# MAX_UPLOAD_BYTES  -- checked by the .mod CGI endpoints (upload_wg.mod /
#                       upload_ovpn.mod) against both the Content-Length
#                       header AND the actual bytes read from stdin (the
#                       header can lie -- a client is free to send any
#                       value or none at all, so the real guard is a hard
#                       `head -c` cap on what we ever write to disk, not
#                       just a header comparison). This is the "don't let
#                       someone upload an ISO" limit -- generous enough
#                       for a multipart POST of a real config (including
#                       MIME boundary/header overhead), nowhere near large
#                       enough for a disk-fill attempt.
#
# WG_CONF_MAX_BYTES / OVPN_CONF_MAX_BYTES -- checked by the backend parse
#                       scripts against the *extracted* config file itself
#                       (post multipart-stripping), as defense in depth --
#                       these get called directly during telnet testing
#                       too, bypassing the CGI layer entirely, so the
#                       backend can't assume the CGI's guard already ran.
#                       OpenVPN's limit is higher than WireGuard's because
#                       legitimate .ovpn files commonly embed inline PEM
#                       certs/keys, which WireGuard configs never do.

MAX_UPLOAD_BYTES=65536        # 64KiB -- full multipart POST body
WG_CONF_MAX_BYTES=8192        # 8KiB  -- parsed WireGuard config has a fixed small schema
OVPN_CONF_MAX_BYTES=32768     # 32KiB -- allows for inline certs/keys
