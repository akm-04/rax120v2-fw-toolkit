prefix=/home/release/rax120-hk2.0-buildroot-20200731110656.git/build_dir/target-aarch64_cortex-a53_musl-1.1.16/safeclib/ipkg-install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libsafec
Description: A safe coding library for C, ref ISO TR24731
Version: UNKNOWN
URL: http://github.com/rurban/safeclib/
Libs: -L${libdir} -lsafec-3.3
Cflags: -I${includedir}/safec-3.3 -I${libdir}/safec-3.3/include
